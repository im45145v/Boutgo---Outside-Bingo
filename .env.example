# Copy to .env and fill in. Never commit .env.
SERPAPI_API_KEY=your_serpapi_key_here
BACKBOARD_API_KEY=your_backboard_key_here
# Open-weight model served through Backboard (verify availability in your Backboard dashboard/docs)
BACKBOARD_LLM_PROVIDER=openrouter
BACKBOARD_MODEL=meta-llama/llama-3.3-70b-instruct
BACKBOARD_BASE_URL=https://app.backboard.io/api
HOST=0.0.0.0
PORT=5000
DATABASE_PATH=outside_bingo.db
