[Unit]
Description=Outside Bingo web application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
ExecStart=/usr/bin/env DATABASE_PATH=/var/lib/outside-bingo/outside_bingo.db PORT=5000 __APP_DIR__/.venv/bin/gunicorn --workers 1 --threads 4 --bind 0.0.0.0:5000 --access-logfile - --error-logfile - app:create_app()
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Keep the application read-only except for its managed SQLite data directory.
StateDirectory=outside-bingo
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

